{
  "name": "@ai-logger/database",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "db:migrate": "dotenv -e .env -- node-pg-migrate up",
    "db:seed": "dotenv -e .env -- tsx src/seed.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "pg": "^8.15.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/pg": "^8.11.0",
    "dotenv-cli": "^11.0.0",
    "node-pg-migrate": "^8.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
