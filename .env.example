# AI Logger Environment Variables
# Copy this to each app's .env file and fill in your values

# ============================================
# Database (used by apps/api and packages/database)
# ============================================
DATABASE_URL=postgresql://ailogger:ailogger@localhost:5432/ailogger

# ============================================
# API Server (used by apps/api)
# ============================================
API_PORT=3001
JWT_SECRET=change-me-to-a-random-string-min-32-chars
CORS_ORIGIN=http://localhost:3000

# ============================================
# AI Provider (used by apps/api)
# ============================================
# Default: Google Gemini Flash
AI_PROVIDER=google
AI_MODEL=gemini-2.0-flash
GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key-here

# Alternative: OpenAI
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your-openai-key-here

# Alternative: Anthropic
# AI_PROVIDER=anthropic
# AI_MODEL=claude-sonnet-4.6
# ANTHROPIC_API_KEY=your-anthropic-key-here

# ============================================
# Dashboard (used by apps/dashboard)
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3001

# ============================================
# Admin Seed (first run only, used by packages/database)
# ============================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-immediately
